meta {
  name: POST /api/users
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/users
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "email": "{{$randomEmail}}",
    "hashedPassword": "{{$randomLoremWord}}",
    "id": "{{$randomUUID}}",
    "name": "{{$randomLoremWord}}"
  }
}

